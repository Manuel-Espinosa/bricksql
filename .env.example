# ── Required ─────────────────────────────────────────────────────────────────
BRICKSQL_USER=admin
BRICKSQL_PASSWORD=changeme
JWT_SECRET=change-this-to-a-random-secret-string

# ── Optional (production) ─────────────────────────────────────────────────────
PORT=3000
DATA_DIR=./data

# ── Dev only (docker-compose.dev.yml) ─────────────────────────────────────────
PORT_BACK=5050
PORT_FRONT=5172
PORT_DB=3001

# ── AI Mode (optional) ────────────────────────────────────────────────────────
# Leave unset to disable the AI mode in the UI
# OLLAMA_URL=http://host.docker.internal:11434

# ── MCP Access (optional) ─────────────────────────────────────────────────────
# Lets AI agents (Claude Code, etc.) run read-only SELECTs over the Connections
# you tick in the "mcp" dialog. Leave BRICKSQL_MCP_TOKEN unset to disable it.
# Endpoint: http://<server>:<PORT>/api/mcp  (Authorization: Bearer <token>)
# BRICKSQL_MCP_TOKEN=generate-with-openssl-rand-hex-32
# Base URL used in Result Snapshot links; defaults to the request's Host.
# BRICKSQL_PUBLIC_URL=http://192.168.1.50:3000
